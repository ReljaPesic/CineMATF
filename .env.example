# --- Postgres: one container ("postgres"), one database per service ---
# Databases (cinemadb / ReservationServiceDb / ScreeningDB / IdentityDB) are
# created by docker/postgres/init-databases.sql on first `up`.
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema

# Host-side connection strings for `dotnet ef` / running a service outside docker.
# The container is published on host port 5433.
CONNECTION_STRING=Host=localhost;Port=5433;Database=ReservationServiceDb;Username=cinema;Password=cinema
IDENTITY_CONNECTION_STRING=Host=localhost;Port=5433;Database=IdentityDB;Username=cinema;Password=cinema

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=cine.matf@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin1234

ASPNETCORE_ENVIRONMENT=Development

# --- Email (ticket confirmation) ---
# Gmail account used to send ticket emails. Enable 2-Step Verification on it, then
# generate an "App Password" (Google Account > Security > App passwords) and use
# that here — NOT the account's normal login password.
EMAIL_SENDER=your.address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
